{{! @glint-nocheck }}{{page-title (t 'route.settings.title')}}

<Nav::Routes::Generic @title={{t 'route.settings.title'}} />

<Common::Container @size='medium'>

  <h3>{{t 'route.settings.category.appearance'}}</h3>

  <Common::Control::Dropdown
    @options={{this.config.themeOptions}}
    @default={{this.currentOptions.currentThemeOption}}
    @onSelect={{this.handleThemeSelect}}
    @size='max'
    @label={{t 'route.settings.theme.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.theme.label'}}
        @text={{t 'route.settings.theme.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <Common::Control::Dropdown
    @options={{this.config.sidebarLayoutOptions}}
    @default={{this.currentOptions.currentSidebarLayoutOption}}
    @onSelect={{this.handleSidebarLayoutSelect}}
    @size='max'
    @label={{t 'route.settings.sidebar.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.sidebar.label'}}
        @text={{t 'route.settings.sidebar.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <Common::Control::Dropdown
    @options={{this.config.fontSizeOptions}}
    @default={{this.currentOptions.currentFontSizeOption}}
    @onSelect={{this.handleFontSizeSelect}}
    @size='max'
    @label={{t 'route.settings.font-size.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.font-size.label'}}
        @text={{t 'route.settings.font-size.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <Common::Control::Dropdown
    @options={{this.config.darkenReadPostsOptions}}
    @default={{this.currentOptions.currentDarkenReadPostsOption}}
    @onSelect={{fn this.handleSettingSelect 'darkenReadPosts'}}
    @size='max'
    @label={{t 'route.settings.darken-read-posts.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.darken-read-posts.label'}}
        @text={{t 'route.settings.darken-read-posts.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <Common::Control::Dropdown
    @options={{this.config.hideGlobalAndAnnouncementThreadsOptions}}
    @default={{this.currentOptions.currentHideGlobalAndAnnouncementThreadsOption}}
    @onSelect={{fn this.handleSettingSelect 'hideGlobalAndAnnouncementThreads'}}
    @size='max'
    @label={{t 'route.settings.hide-global-and-announcement-threads.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.hide-global-and-announcement-threads.label'}}
        @text={{t 'route.settings.hide-global-and-announcement-threads.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <h3>{{t 'route.settings.category.network'}}</h3>

  <Common::Control::Dropdown
    @options={{this.config.avatarStyleOptions}}
    @default={{this.currentOptions.currentAvatarStyleOption}}
    @onSelect={{fn this.handleSettingSelect 'avatarStyle'}}
    @size='max'
    @label={{t 'route.settings.avatar-style.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.avatar-style.label'}}
        @text={{t 'route.settings.avatar-style.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <Common::Control::Dropdown
    @options={{this.config.autoRefreshSidebarOptions}}
    @default={{this.currentOptions.currentAutoRefreshSidebarOption}}
    @onSelect={{this.handleAutoRefreshSidebarSelect}}
    @size='max'
    @label={{t 'route.settings.auto-refresh-sidebar.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.auto-refresh-sidebar.label'}}
        @text={{t 'route.settings.auto-refresh-sidebar.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <Common::Control::Dropdown
    @options={{this.config.appsignalErrorReportingOptions}}
    @default={{this.currentOptions.currentAppsignalErrorReportingOption}}
    @onSelect={{this.handleAppsignalErrorReportingSelect}}
    @size='max'
    @label={{t 'route.settings.appsignal-error-reporting.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.appsignal-error-reporting.label'}}
        @text={{t 'route.settings.appsignal-error-reporting.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <h3>{{t 'route.settings.category.behavior'}}</h3>

  <Common::Control::Dropdown
    @options={{this.config.landingPageOptions}}
    @default={{this.currentOptions.currentLandingPageOption}}
    @onSelect={{fn this.handleSettingSelect 'landingPage'}}
    @size='max'
    @label={{t 'route.settings.landing-page.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.landing-page.label'}}
        @text={{t 'route.settings.landing-page.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <Common::Control::Dropdown
    @options={{this.config.transitionsOptions}}
    @default={{this.currentOptions.currentTransitionsOption}}
    @onSelect={{fn this.handleSettingSelect 'transitions'}}
    @size='max'
    @label={{t 'route.settings.transitions.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.transitions.label'}}
        @text={{t 'route.settings.transitions.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <Common::Control::Dropdown
    @options={{this.config.replaceForumUrlsOptions}}
    @default={{this.currentOptions.currentReplaceForumUrlsOption}}
    @onSelect={{fn this.handleSettingSelect 'replaceForumUrls'}}
    @size='max'
    @label={{t 'route.settings.replace-forum-urls.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.replace-forum-urls.label'}}
        @text={{t 'route.settings.replace-forum-urls.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <Common::Control::Dropdown
    @options={{this.config.goToBottomOfThreadPageOptions}}
    @default={{this.currentOptions.currentGoToBottomOfThreadPageOption}}
    @onSelect={{fn this.handleSettingSelect 'goToBottomOfThreadPage'}}
    @size='max'
    @label={{t 'route.settings.go-to-bottom-of-thread-page.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.go-to-bottom-of-thread-page.label'}}
        @text={{t 'route.settings.go-to-bottom-of-thread-page.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <Common::Control::Dropdown
    @options={{this.config.collapseQuotesOptions}}
    @default={{this.currentOptions.currentCollapseQuotesOption}}
    @onSelect={{fn this.handleSettingSelect 'collapseQuotes'}}
    @size='max'
    @label={{t 'route.settings.collapse-quotes.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.collapse-quotes.label'}}
        @text={{t 'route.settings.collapse-quotes.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <Common::Control::Dropdown
    @options={{this.config.gesturesOptions}}
    @default={{this.currentOptions.currentGesturesOption}}
    @onSelect={{this.handleGesturesSelect}}
    @size='max'
    @label={{t 'route.settings.enable-gestures.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.enable-gestures.label'}}
        @text={{format-message
          'route.settings.enable-gestures.info'
          htmlSafe=true
        }}
      />
    </:info>
  </Common::Control::Dropdown>

  <div class='flex-row align-items-center'>
    <h3 class='margin-horizontal-x-small'>{{t 'feature.blocklist.title'}}</h3>
    <Common::Control::InfoButton
      @title={{t 'feature.blocklist.title'}}
      @text={{t 'feature.blocklist.description'}}
      @variant='secondary-transparent'
      @icon='info-circle'
    />
  </div>

  <Features::Blocklist />

  <div class='flex-row align-items-center'>
    <h3 class='margin-horizontal-x-small'>
      {{t 'route.settings.category.sync'}}
    </h3>
    <Common::Control::InfoButton
      @title={{t 'route.settings.category.sync'}}
      @text={{t 'route.settings.sync.description'}}
      @variant='secondary-transparent'
      @icon='info-circle'
    />
  </div>
  <p>
    <strong>{{t 'route.settings.sync.status.label'}}:</strong>
    {{this.syncStatusLabel}}
  </p>

  {{#if this.settingsSync.lastError}}
    <p>{{t 'route.settings.sync.last-error'}}</p>
  {{/if}}

  <div class='settings-sync-actions margin-vertical-x-small'>
    {{#if this.syncIsDisabled}}
      <Common::Control::Button
        @text={{t 'route.settings.sync.enable'}}
        @icon='lock'
        @variant='primary'
        @size='large'
        @busy={{this.syncActionBusy}}
        @onClick={{this.handleEnableSync}}
        data-test-settings-sync-enable
      />
    {{else if this.syncIsLocked}}
      <Common::Control::Button
        @text={{t 'route.settings.sync.unlock.submit'}}
        @icon='key'
        @variant='primary'
        @size='large'
        @busy={{this.syncActionBusy}}
        @onClick={{this.handleUnlockSync}}
        data-test-settings-sync-unlock
      />
      <Common::Control::Button
        @text={{t 'route.settings.sync.delete.submit'}}
        @icon='trash'
        @variant='secondary'
        @size='large'
        @busy={{this.syncActionBusy}}
        @onClick={{this.handleDeleteSync}}
        data-test-settings-sync-delete
      />
    {{else if this.syncIsEnabled}}
      <Common::Control::Button
        @text={{t 'route.settings.sync.forget.submit'}}
        @icon='key'
        @variant='primary'
        @size='large'
        @busy={{this.syncActionBusy}}
        @onClick={{this.handleForgetSyncKey}}
        data-test-settings-sync-forget
      />
      <Common::Control::Button
        @text={{t 'route.settings.sync.delete.submit'}}
        @icon='trash'
        @variant='secondary'
        @size='large'
        @busy={{this.syncActionBusy}}
        @onClick={{this.handleDeleteSync}}
        data-test-settings-sync-delete
      />
    {{else if this.syncIsUnavailable}}
      <Common::Control::Button
        @text={{t 'route.settings.sync.retry'}}
        @icon='arrows-rotate'
        @variant='primary'
        @size='large'
        @busy={{this.syncActionBusy}}
        @onClick={{this.handleRetrySync}}
        data-test-settings-sync-retry
      />
    {{/if}}
  </div>

  <h3>{{t 'route.settings.category.advanced'}}</h3>

  <Common::Control::Dropdown
    @options={{this.config.debugOptions}}
    @default={{this.currentOptions.currentDebugOption}}
    @onSelect={{this.handleDebugSelect}}
    @size='max'
    @label={{t 'route.settings.debug.label'}}
  >
    <:info>
      <Common::Control::InfoButton
        @title={{t 'route.settings.debug.label'}}
        @text={{t 'route.settings.debug.info'}}
      />
    </:info>
  </Common::Control::Dropdown>

  <hr />

  <div class='settings-app-actions'>
    <Common::Control::Button
      @text={{t 'route.settings.refresh-app'}}
      @icon='arrows-rotate'
      @variant='primary'
      @size='large'
      @onClick={{this.handleRefreshApp}}
      data-test-refresh-app
    />

    <Common::Control::Link @route='applog' @size='large' @variant='primary'>
      <FaIcon @icon='rectangle-list' />
      <p>{{t 'route.applog.title'}}</p>
    </Common::Control::Link>

    <Common::Control::Link @route='changelog' @size='large' @variant='primary'>
      <FaIcon @icon='star' @prefix='fas' />
      <p>{{t 'route.changelog.title'}}</p>
    </Common::Control::Link>

    <Common::Control::Link @route='about' @size='large' @variant='primary'>
      <FaIcon @icon='info-circle' @prefix='fas' />
      <p>{{t 'route.about.title'}}</p>
    </Common::Control::Link>
  </div>

  <hr />

  <h3>{{t 'route.settings.session.title'}}</h3>
  <p class='no-margin'>{{t 'route.settings.session.user-id'}}:
    {{@model.session.userId}}</p>
  <p>{{t 'route.settings.session.username'}}: {{@model.session.username}}</p>
  <Common::Control::Button
    @text={{t 'route.settings.session.sign-out'}}
    @icon='right-from-bracket'
    @variant='primary'
    @size='large'
    @onClick={{this.handleSignOut}}
  />

</Common::Container>